# Copy to .asc.env (git-ignored) for scripts/release-pack.sh.
# App Store Connect › Users and Access › Integrations › App Store Connect API: create a Team key with the
# App Manager role. Download its .p8 to ~/private_keys/AuthKey_<KEY_ID>.p8 (it can only be downloaded once).
ASC_KEY_ID=            # e.g. 2X9R4HXF34
ASC_ISSUER_ID=         # the Issuer ID shown above the keys table
ASC_APP_ID=            # the app's Apple ID: App Store Connect › the app › App Information › Apple ID (a number)
