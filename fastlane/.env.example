# Copy to fastlane/.env (ignored by git) to run the release lanes from your Mac.
# In GitHub Actions the same names are repository secrets and variables. See docs/release.md.

# App Store Connect API key (Users and Access › Integrations › App Store Connect API), role: Admin.
ASC_KEY_ID=
ASC_ISSUER_ID=
# base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy
ASC_KEY_P8_BASE64=

# Who App Review contacts about a submission.
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_PHONE=
REVIEW_EMAIL=

# Where site/ is published; privacy.html and support.html must load from here.
APP_SITE_URL=

# Optional: comma-separated external TestFlight groups that get every main build.
TESTFLIGHT_GROUPS=
